<web-app>
    <servlet>
        <servlet-name>SearchServlet</servlet-name>
        <servlet-class>com.mongodb.search.SearchServlet</servlet-class>
        <load-on-startup>1</load-on-startup>
    </servlet>

    <servlet-mapping>
        <servlet-name>SearchServlet</servlet-name>
        <url-pattern>/search</url-pattern>
    </servlet-mapping>
</web-app>